<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>html{background:#061628}</style>
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta name="description" content="{{ description }}" />
<meta name="robots" content="{{ robots or 'index, follow' }}" />
<meta name="author" content="{{ site.author }}" />
<title>{{ title }}</title>
<link rel="canonical" href="{{ canonical }}" />
<link rel="alternate" hreflang="en" href="{{ hreflangEn or canonical }}" />
{%- if hreflangBn %}
<link rel="alternate" hreflang="bn-BD" href="{{ hreflangBn }}" />
{%- endif %}
<link rel="alternate" hreflang="x-default" href="{{ hreflangEn or canonical }}" />
<!-- Open Graph -->
<meta property="og:title" content="{{ ogTitle or title }}" />
<meta property="og:description" content="{{ ogDescription or description }}" />
<meta property="og:url" content="{{ canonical }}" />
<meta property="og:type" content="{{ ogType or 'article' }}" />
{%- if ogImage %}
<meta property="og:image" content="{{ ogImage }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{%- endif %}
<meta property="og:locale" content="{{ ogLocale or 'en_US' }}" />
<meta property="og:site_name" content="{{ ogSiteName or site.siteName }}" />
{%- if ogType != 'website' and datePublished %}
<meta property="article:author" content="{{ site.linkedin }}" />
<meta property="article:published_time" content="{{ datePublished }}" />
<meta property="article:modified_time" content="{{ dateModified }}" />
{%- if articleSection %}
<meta property="article:section" content="{{ articleSection }}" />
{%- endif %}
{%- endif %}
<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}" />
<meta name="twitter:description" content="{{ twitterDescription or ogDescription or description }}" />
{%- if ogImage %}
<meta name="twitter:image" content="{{ ogImage }}" />
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
{%- if jsonLd %}
<!-- JSON-LD -->
<script type="application/ld+json">
{{ jsonLd | safe }}
</script>
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500{% if lang == 'bn' or fontsBn %}&family=Noto+Sans+Bengali:wght@400;500;600;700{% endif %}&family=Instrument+Serif:ital@0;1&display=swap">
<script>
  (function () {
    var t = localStorage.getItem('mh-theme');
    if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    else if (t !== 'dark') document.documentElement.setAttribute('data-theme', 'dark-navy');
  })();
</script>
{%- if stylesheetHref != false %}
<link rel="stylesheet" href="{{ stylesheetHref or '/lab/_styles.css' }}">
{%- endif %}
{%- if toolsCss %}
<link rel="stylesheet" href="/tools/_tools.css">
{%- endif %}
{%- if extraStyles %}
<style>
{{ extraStyles | safe }}
</style>
{%- endif %}
</head>
<body>
{%- if not bareBody %}
<div class="grid-bg"></div>

<header class="nav">
  <div class="shell">
    <div class="nav-inner">
      <a class="brand" href="{{ homeHref or '/' }}">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name"><b>{{ site.name }}</b><em>{% if lang == 'bn' %}ERP · বিজনেস অ্যানালিস্ট{% else %}{{ site.brandTagline }}{% endif %}</em></span>
      </a>
      <a class="back-link" href="{{ backHref or '/#lab' }}">{% if lang == 'bn' %}← ল্যাব-এ ফিরুন{% else %}← Back to Lab{% endif %}</a>
    </div>
  </div>
</header>
{%- endif %}

{{ content | safe }}

{%- if not bareBody %}
<script src="/lab/_utils.js" defer></script>
<script src="/lab/_toc.js" defer></script>
{%- endif %}
<script src="/whatsapp.js" defer></script>
<script src="/scroll-top.js" defer></script>
</body>
</html>
