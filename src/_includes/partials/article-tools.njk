{#- "Put it into practice" box at the end of a Lab article, driven by _data/articleTools.js. -#}
{%- set num = page.fileSlug.slice(0, 4) -%}
{%- set keys = articleTools.MAP[num] -%}
{%- if keys -%}
{%- set L = 'bn' if lang == 'bn' else 'en' -%}
{%- set pre = '/bn' if lang == 'bn' else '' -%}
<div class="shell">
  <aside class="practice-box" aria-label="{{ 'Put it into practice' if L == 'en' else 'কাজে লাগান' }}" style="max-width:var(--measure,680px);margin:8px auto 40px;border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:0 12px 12px 0;padding:18px 20px;background:var(--surface)">
    <span style="display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px">{{ 'Put it into practice · free' if L == 'en' else 'কাজে লাগান · বিনামূল্যে' }}</span>
    <div style="display:grid;gap:10px">
      {%- for k in keys %}{% set t = articleTools.TOOLS[k] %}
      <a href="{{ pre }}{{ t.href }}" style="display:flex;justify-content:space-between;gap:12px;align-items:baseline;text-decoration:none;color:var(--text)"><span><b style="font-weight:500">{{ t[L][0] }}</b> <span style="color:var(--text-2);font-size:14px">· {{ t[L][1] }}</span></span><span style="color:var(--accent)">→</span></a>
      {%- endfor %}
    </div>
  </aside>
</div>
{%- endif -%}
